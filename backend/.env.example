# DCTIN Backend Configuration

# Blockchain RPC URL (Hardhat local node)
RPC_URL=http://127.0.0.1:8545

# Private key for transaction signing (Hardhat test account #0 by default)
# This is the default Hardhat test account - DO NOT use in production
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# DCTIN Contract Address (update after deployment)
# Example: CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CONTRACT_ADDRESS=

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*
